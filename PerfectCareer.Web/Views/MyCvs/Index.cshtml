@using System.Globalization
@using PerfectCareer.Web.Models.Cvs
@using PerfectCareer.Web.ViewModels.Cvs
@model CandidateCvsIndexViewModel

@{
    ViewData["Title"] = "My CVs";

    string FormatDate(DateTimeOffset value) =>
        value.ToLocalTime().ToString(
            "MMM d, yyyy",
            CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Pages_/profile.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Pages_/my-cvs.css"
          asp-append-version="true" />
}

<div class="pc-profile-page">
    <div class="container-xl pc-profile-shell">
        <partial name="~/Views/CandidateProfile/_ProfileHeader.cshtml"
                 model="Model.Profile" />

        @if (TempData["CvMessage"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">
                @message

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        @if (TempData["CvError"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">
                @error

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <section class="pc-profile-card pc-my-cvs-card">
            <header class="pc-my-cvs-heading">
                <div>
                    <p class="pc-card-eyebrow">CVS</p>

                    <h2>My CVs</h2>

                    <p>
                        Manage the tailored CVs created for your applications.
                    </p>
                </div>

                <a class="btn btn-primary"
                   asp-controller="CandidatePositions"
                   asp-action="Index">
                    Browse positions
                </a>
            </header>

            @if (Model.Cvs.Count == 0)
            {
                <div class="pc-empty-state pc-my-cvs-empty">
                    <h3>No CVs yet</h3>

                    <p>
                        Browse available positions and apply to generate
                        your first tailored CV.
                    </p>

                    <a class="btn btn-outline-primary mt-3"
                       asp-controller="CandidatePositions"
                       asp-action="Index">
                        View positions
                    </a>
                </div>
            }
            else
            {
                <div class="pc-cv-list"
                     aria-label="My CVs">

                    @foreach (var cv in Model.Cvs)
                    {
                        var isPublished =
                            cv.Status == CandidateCvStatus.Published;

                        <article class="pc-cv-list-card">
                            <div class="pc-cv-list-main">
                                <div class="pc-cv-list-title-row">
                                    <div>
                                        <h3>@cv.PositionTitle</h3>

                                        <p class="pc-cv-list-meta">
                                            <span>@cv.PositionLocation</span>
                                            <span aria-hidden="true">•</span>
                                            <span>@cv.EmploymentType</span>
                                        </p>
                                    </div>

                                    <span class="pc-cv-list-status @(isPublished ? "published" : "draft")">
                                        @(isPublished
                                            ? "Published"
                                            : "Draft")
                                    </span>
                                </div>

                                <div class="pc-cv-list-details">
                                    <span>
                                        Updated @FormatDate(cv.UpdatedAtUtc)
                                    </span>

                                    <span aria-hidden="true">•</span>

                                    <span>
                                        @cv.SelectedProjectCount
                                        @(cv.SelectedProjectCount == 1
                                            ? "selected project"
                                            : "selected projects")
                                    </span>

                                    @if (cv.PublishedAtUtc.HasValue)
                                    {
                                        <span aria-hidden="true">•</span>

                                        <span>
                                            Published
                                            @FormatDate(
                                                cv.PublishedAtUtc.Value)
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="pc-cv-list-actions">
                                <a class="btn btn-outline-primary"
                                   asp-controller="CandidateCvs"
                                   asp-action="Edit"
                                   asp-route-id="@cv.Id">
                                    @(isPublished
                                        ? "View CV"
                                        : "Continue editing")
                                </a>

                                <a class="btn btn-outline-danger"
                                   asp-controller="MyCvs"
                                   asp-action="Delete"
                                   asp-route-id="@cv.Id">
                                    Delete
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>